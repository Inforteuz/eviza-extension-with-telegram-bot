# Copy to .env and keep chmod 600. Do not put secrets in Telegram messages.
# Standalone Telegram mode stores applications and images on this Mac.
RUN_MODE=telegram
# The following panel settings are only used by the optional legacy panel mode/migration.
PANEL_URL=https://evisa-operator-uz.saidaxmadddd.chatgpt.site
PANEL_TOKEN=
# Private Sites dispatch credential; needed in addition to PANEL_TOKEN.
OAI_SITES_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=
# Passport text is read by the AI API. There is no local OCR fallback.
OPENAI_API_KEY=
PASSPORT_AI_MODEL=gpt-4.1
SAUDI_EMAIL=
SAUDI_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Exact sender address observed in a genuine Saudi verification email.
GMAIL_OTP_SENDER=
# Leave 0 until all visa steps have been inspected and mapped.
ENABLE_VISA_SUBMISSION=0
# Dedicated visible browser for one-time login / CAPTCHA and operator payment.
HEADLESS=0

# Python interpreter with agent/requirements.txt installed
PYTHON_BIN=python3

# Optional: msedge or chrome, both use the dedicated Saudi profile
BROWSER_CHANNEL=

# Gmail App Password connection (alternative to OAuth)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Enabled by connect-mini-app.mjs after the deployed app is verified
TELEGRAM_MINI_APP_ENABLED=0

# playwright (default) or userscript; configure the pairing code in local settings
BROWSER_MODE=playwright
USERSCRIPT_TOKEN=
