# ---- Telegram ----
# Токен от @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Числовые Telegram ID администраторов через запятую (узнать: @userinfobot).
ADMIN_IDS=
# Аккаунт поддержки без @ (необязательно).
SUPPORT_USERNAME=

# ---- Оплата ----
# 1) Click/Payme через Telegram Payments: @BotFather -> бот -> Payments -> провайдер -> токен.
PAYMENT_PROVIDER_TOKEN=
# 2) Перевод на карту + чек (подтверждает администратор). Можно включить оба способа.
CARD_NUMBER=
CARD_HOLDER=
# Цена за 1 паспорт в сумах. Потом меняется в боте командой /narx.
PRICE_PER_PASSPORT=5000
# Бонус новому пользователю в сумах (0 — без бонуса).
WELCOME_BONUS=0
MIN_TOPUP=20000
MAX_TOPUP=10000000
TOPUP_AMOUNTS=20000,50000,100000,200000,500000
# Повторная загрузка того же паспорта в течение N дней не списывается.
DEDUPE_DAYS=30

# ---- Распознавание текста паспорта ----
# Достаточно одного ключа. Если заданы оба, используется OpenAI (или AI_PROVIDER).
# Gemini: ключ из https://aistudio.google.com/apikey (AIza... или AQ...).
GEMINI_API_KEY=
# Модели по порядку через запятую. Модель, ответившая 503/429/500/404 или таймаутом,
# уходит в конец списка на 3 минуты; ответившая модель остаётся первой на 10 минут.
# Если модель молчит 12 с, параллельно запускается следующая, берётся первый ответ.
# По умолчанию:
# GEMINI_MODEL=gemini-3.7-flash,gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
# Уровень рассуждения: high (по умолчанию), medium, low, minimal или off.
GEMINI_THINKING=high
# OpenAI: ключ sk-...
OPENAI_API_KEY=
PASSPORT_AI_MODEL=gpt-4.1
# Принудительный выбор провайдера: gemini или openai (необязательно).
# AI_PROVIDER=gemini
# Python с OpenCV для работы с изображениями. Только для запуска без Docker
# (в Docker всегда используется /opt/venv/bin/python из образа).
# PYTHON_BIN=/opt/evisa/server/.venv/bin/python

# ---- Сервер ----
HOST=0.0.0.0
PORT=8080
DATA_DIR=data
# Ссылка на скачивание расширения (показывается в боте).
EXTENSION_URL=
# Только для тестов / локального Bot API сервера.
# TELEGRAM_API_BASE=https://api.telegram.org
