# Домен берётся из переменной DOMAIN (файл .env рядом с docker-compose.yml).
# HTTPS-сертификат выпускается автоматически; A-запись домена должна указывать на сервер.
{$DOMAIN} {
	encode gzip
	# Архив расширения для операторов: https://<домен>/download/evisa-auto-filler.zip
	handle_path /download/* {
		root * /srv/download
		file_server
	}
	handle {
		reverse_proxy server:8080
	}
}
