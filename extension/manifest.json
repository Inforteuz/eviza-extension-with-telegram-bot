{
  "manifest_version": 3,
  "name": "eVisa Auto-Filler",
  "short_name": "eVisa",
  "version": "1.0.3",
  "description": "Saudi eVisa arizalarini pasport rasmidan to‘lov sahifasigacha avtomatik to‘ldiradi. Telegram bot orqali ulanadi.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "scripting"],
  "host_permissions": ["https://visa.visitsaudi.com/*"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "side_panel": {"default_path": "src/panel/panel.html"},
  "action": {
    "default_title": "eVisa Auto-Filler",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["https://visa.visitsaudi.com/*"],
    "js": ["src/content/dom-ops.js", "src/content/content.js"],
    "run_at": "document_idle"
  }]
}
